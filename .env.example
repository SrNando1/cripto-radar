# Chave demo gratuita da CoinGecko (opcional mas recomendada).
# Sem chave, a API pública é fortemente limitada e pode devolver erros 429.
# Cria a tua em: https://www.coingecko.com/en/developers/dashboard
# Depois copia este ficheiro para .env e preenche o valor.
VITE_CG_API_KEY=

# Supabase (autenticação) — cria um projeto gratuito em https://supabase.com
# e copia de Project Settings → API. A anon key é pública por design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# LemonSqueezy (pagamentos) — links "Share" dos produtos Pro e Trader
# (ex.: https://aloja.lemonsqueezy.com/buy/uuid-do-produto)
VITE_LS_CHECKOUT_PRO=
VITE_LS_CHECKOUT_TRADER=

# Só no servidor (Vercel → Environment Variables), NUNCA com prefixo VITE_:
# LEMONSQUEEZY_WEBHOOK_SECRET=  (signing secret do webhook no LS)
# SUPABASE_SERVICE_ROLE_KEY=    (Project Settings → API → service_role)
# SUPABASE_URL=                 (igual ao VITE_SUPABASE_URL)
